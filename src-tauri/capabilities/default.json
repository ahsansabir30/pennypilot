{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus PennyPilot's own commands only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-workspace-status",
    "allow-create-workspace-command",
    "allow-unlock-workspace-command",
    "allow-recover-workspace-command",
    "allow-lock-workspace",
    "allow-list-finance-data",
    "allow-list-transactions",
    "allow-create-transaction",
    "allow-update-transaction-category",
    "allow-delete-transaction",
    "allow-list-category-rules",
    "allow-save-category-rule",
    "allow-delete-category-rule",
    "allow-save-category",
    "allow-delete-category",
    "allow-reclassify-transactions",
    "allow-reset-transaction-category",
    "allow-list-budgets",
    "allow-save-budget",
    "allow-delete-budget",
    "allow-save-budget-preferences",
    "allow-list-savings-goals",
    "allow-save-savings-goal",
    "allow-delete-savings-goal",
    "allow-private-data-locations",
    "allow-export-private-transactions",
    "allow-create-private-backup",
    "allow-restore-private-backup"
  ]
}
